; Engine configuration file.

config_version=5

[application]

config/name="UniRp"
config/description="RPG de vida com NPCs controlados por IA"
run/main_scene="res://main.tscn"
run/max_fps=60
config/features=PackedStringArray("4.7")

[autoload]

Settings="*res://autoload/settings.gd"
GameState="*res://autoload/game_state.gd"
TimeManager="*res://autoload/time_manager.gd"
NeedsSystem="*res://autoload/needs_system.gd"
World="*res://autoload/world.gd"
AIService="*res://autoload/ai_service.gd"
NPCManager="*res://autoload/npc_manager.gd"
PhoneSystem="*res://autoload/phone_system.gd"
CrimeSystem="*res://autoload/crime_system.gd"
HomeSystem="*res://autoload/home_system.gd"
JobSystem="*res://autoload/job_system.gd"
BusinessSystem="*res://autoload/business_system.gd"
AddictionSystem="*res://autoload/addiction_system.gd"
WorldEvents="*res://autoload/world_events.gd"
NewsSystem="*res://autoload/news_system.gd"
Population="*res://autoload/population.gd"
AgingSystem="*res://autoload/aging_system.gd"
Holidays="*res://autoload/holidays.gd"
SocialSystem="*res://autoload/social_system.gd"
Houses="*res://autoload/houses.gd"
Economy="*res://autoload/economy.gd"
SaveManager="*res://autoload/save_manager.gd"

[display]

window/size/viewport_width=1366
window/size/viewport_height=768
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="chao"
3d_physics/layer_2="parede"
3d_physics/layer_3="movel"
3d_physics/layer_4="veiculo"
3d_physics/layer_5="npc"
3d_physics/layer_6="jogador"
3d_physics/layer_7="animal"
3d_physics/layer_8="vegetacao"
3d_physics/layer_9="interativo"
3d_physics/layer_10="area_trigger"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"

[shader_globals]

world_wind={
"type": "vec3",
"value": Vector3(0.32, 0, 0.24)
}

wetness={
"type": "float",
"value": 0.0
}
rain_time={
"type": "float",
"value": 0.0
}
player_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
night_glow={
"type": "float",
"value": 0.0
}
grime={
"type": "float",
"value": 0.5
}
cloud_shade={
"type": "float",
"value": 0.0
}
pom_quality={
"type": "float",
"value": 1.0
}
